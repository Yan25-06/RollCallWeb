# Supabase — bắt buộc. Lấy từ Supabase Dashboard → Project Settings → API.
# Thiếu một trong hai biến này, src/lib/supabase.js sẽ throw khi khởi động.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google Sheets API — tùy chọn. Cần cho tab "Tài Liệu" đọc giáo trình từ Google Sheet (xem README).
VITE_GOOGLE_SHEETS_API_KEY=
